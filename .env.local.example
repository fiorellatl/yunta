# Copia este archivo como .env.local y pega las credenciales de tu proyecto Supabase.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Solo servidor. Nunca la expongas al cliente ni la subas al repo.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# URL base del sitio, para los links de acceso por correo.
NEXT_PUBLIC_SITE_URL=http://localhost:3007
